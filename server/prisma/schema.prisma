// Prisma schema — datasource and generator are pre-wired.
// Your DATABASE_URL lives in server/.env (copy it from .env.example).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Issue 3 — Create and seed IT request categories
// Define a Category model with:
//   id        Int      @id @default(autoincrement())
//   name      String   @unique
//   createdAt DateTime @default(now())
// Then run:  npx prisma migrate dev --name init
// ---------------------------------------------------------------------------

model Category {
  id        Int      @id @default(autoincrement())
  // Case-sensitive uniqueness is the Prisma default for String. If you need
  // case-insensitive uniqueness, use a database-specific solution such as CITEXT.
  name      String   @unique
  // Using Prisma's @default(now()) with PostgreSQL keeps timestamps at the DB
  // level. If you need timezone-aware values explicitly, switch to timestamptz
  // in the migration (for example, `createdAt DateTime @default(now())` on a
  // PostgreSQL timestamptz column via a migration).
  createdAt DateTime @default(now())
}
