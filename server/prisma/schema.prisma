generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum TicketStatus {
  NEW
  OPEN
  IN_PROGRESS
  RESOLVED
  WAITING_FOR_REQUESTER
  CLOSED
  REOPENED
  CANCELLED
  PENDING
}

enum UserRole {
  REQUESTER
  IT_STAFF
  ADMINISTRATOR
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tickets        Ticket[]
  publicComments PublicComment[]
  internalNotes  InternalNote[]
}

model Requester {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tickets Ticket[]
  users   User[]

  @@index([isActive])
}

model User {
  id                 Int             @id @default(autoincrement())
  name               String
  email              String          @unique
  passwordHash       String
  role               UserRole
  isActive           Boolean         @default(true)
  mustChangePassword Boolean         @default(true)
  legacyRequesterId  Int?            @unique
  legacyRequester    Requester?      @relation(fields: [legacyRequesterId], references: [id])
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  publicComments     PublicComment[]
  internalNotes      InternalNote[]
  submittedTickets   Ticket[]        @relation("TicketRequesterUser")
  ownedTickets       Ticket[]        @relation("TicketOwner")

  @@index([role, isActive])
  @@index([mustChangePassword])
}

model RelatedSystem {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tickets Ticket[]
}

model Ticket {
  id                Int          @id @default(autoincrement())
  ticketNumber      String       @unique
  requesterId       Int
  requesterUserId   Int
  categoryId        Int
  relatedSystemId   Int
  summary           String
  description       String
  requestedPriority Priority
  itPriority        Priority?
  status            TicketStatus @default(NEW)
  ticketOwnerId     Int?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  requester                User            @relation("TicketRequesterUser", fields: [requesterUserId], references: [id])
  legacyRequester          Requester       @relation(fields: [requesterId], references: [id])
  ticketOwner              User?           @relation("TicketOwner", fields: [ticketOwnerId], references: [id])
  category                 Category        @relation(fields: [categoryId], references: [id])
  relatedSystem            RelatedSystem   @relation(fields: [relatedSystemId], references: [id])
  attachments              Attachment[]
  publicComments           PublicComment[]
  internalNotes            InternalNote[]
  problemAppearsResolvedAt DateTime?

  @@index([requesterId])
  @@index([requesterUserId])
  @@index([status, requestedPriority])
}

model Attachment {
  id               Int       @id @default(autoincrement())
  ticketId         Int
  originalFilename String
  storedFilename   String    @unique
  mimeType         String
  sizeBytes        Int
  uploadedAt       DateTime  @default(now())
  removedAt        DateTime?
  removalReason    String?

  ticket Ticket @relation(fields: [ticketId], references: [id])

  @@index([ticketId])
  @@index([removedAt])
}

model PublicComment {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  authorId  Int
  content   String
  createdAt DateTime @default(now())

  ticket     Ticket    @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  author     User      @relation(fields: [authorId], references: [id], onDelete: Restrict)
  category   Category? @relation(fields: [categoryId], references: [id])
  categoryId Int?

  @@index([ticketId, createdAt])
  @@index([authorId, createdAt])
}

model InternalNote {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  authorId  Int
  content   String
  createdAt DateTime @default(now())

  ticket     Ticket    @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  author     User      @relation(fields: [authorId], references: [id], onDelete: Restrict)
  category   Category? @relation(fields: [categoryId], references: [id])
  categoryId Int?

  @@index([ticketId, createdAt])
  @@index([authorId, createdAt])
}
